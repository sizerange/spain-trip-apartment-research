{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Apartment pair publication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewedAt",
    "disclaimer",
    "pairs",
    "budgetExceptions"
  ],
  "properties": {
    "reviewedAt": {
      "type": "string",
      "minLength": 1
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1
    },
    "pairs": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rank",
          "paperId",
          "apartmentId",
          "title",
          "summary",
          "status",
          "statusNote",
          "areas",
          "beachDistanceMinutes",
          "combinedMonthlyRentEur",
          "poolDistance",
          "beachDistance",
          "groceriesDistance",
          "cafesDistance",
          "pairWalkingDistance",
          "pairWalkingTime",
          "paper",
          "apartment"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "paperId": {
            "type": "string",
            "minLength": 1
          },
          "apartmentId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "provisional"
            ]
          },
          "statusNote": {
            "type": "string",
            "minLength": 1
          },
          "areas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "beachDistanceMinutes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "combinedMonthlyRentEur": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "poolDistance": {
            "type": "string",
            "minLength": 1
          },
          "beachDistance": {
            "type": "string",
            "minLength": 1
          },
          "groceriesDistance": {
            "type": "string",
            "minLength": 1
          },
          "cafesDistance": {
            "type": "string",
            "minLength": 1
          },
          "pairWalkingDistance": {
            "type": "string",
            "minLength": 1
          },
          "pairWalkingTime": {
            "type": "string",
            "minLength": 1
          },
          "paper": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "displayName",
              "area",
              "address",
              "bedrooms",
              "sizeSqm",
              "monthlyRentEur",
              "furnished",
              "availabilityStatus",
              "availabilityNote",
              "originalListingUrl",
              "photoSourceUrl",
              "photoAttribution",
              "photos",
              "sourceName",
              "sourceCheckedAt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "displayName": {
                "type": "string",
                "minLength": 1
              },
              "area": {
                "type": "string",
                "minLength": 1
              },
              "address": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bedrooms": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sizeSqm": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "monthlyRentEur": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "furnished": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "availabilityStatus": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "unknown",
                  "unavailable"
                ]
              },
              "availabilityNote": {
                "type": "string",
                "minLength": 1
              },
              "originalListingUrl": {
                "type": "string",
                "format": "uri"
              },
              "photoSourceUrl": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "photoAttribution": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "photos": {
                "type": "array",
                "minItems": 4,
                "maxItems": 9,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "url",
                    "alt",
                    "sourceUrl",
                    "attribution",
                    "aiEdited"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "alt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sourceUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "attribution": {
                      "type": "string",
                      "minLength": 1
                    },
                    "aiEdited": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "sourceName": {
                "type": "string",
                "minLength": 1
              },
              "sourceCheckedAt": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "apartment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "displayName",
              "area",
              "address",
              "bedrooms",
              "sizeSqm",
              "monthlyRentEur",
              "furnished",
              "availabilityStatus",
              "availabilityNote",
              "originalListingUrl",
              "photoSourceUrl",
              "photoAttribution",
              "photos",
              "sourceName",
              "sourceCheckedAt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "displayName": {
                "type": "string",
                "minLength": 1
              },
              "area": {
                "type": "string",
                "minLength": 1
              },
              "address": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bedrooms": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sizeSqm": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "monthlyRentEur": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "furnished": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "availabilityStatus": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "unknown",
                  "unavailable"
                ]
              },
              "availabilityNote": {
                "type": "string",
                "minLength": 1
              },
              "originalListingUrl": {
                "type": "string",
                "format": "uri"
              },
              "photoSourceUrl": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "photoAttribution": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "photos": {
                "type": "array",
                "minItems": 4,
                "maxItems": 9,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "url",
                    "alt",
                    "sourceUrl",
                    "attribution",
                    "aiEdited"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "alt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sourceUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "attribution": {
                      "type": "string",
                      "minLength": 1
                    },
                    "aiEdited": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "sourceName": {
                "type": "string",
                "minLength": 1
              },
              "sourceCheckedAt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "budgetExceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pairId",
          "reason"
        ],
        "properties": {
          "pairId": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "archivePairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pairId",
          "reason"
        ],
        "properties": {
          "pairId": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "restorePairIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "pairs": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "archivePairs"
      ],
      "properties": {
        "archivePairs": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "restorePairIds"
      ],
      "properties": {
        "restorePairIds": {
          "minItems": 1
        }
      }
    }
  ]
}
